{
  "name": "metaharness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node scripts/verify-browser.mjs",
    "build:web": "expo export -p web",
    "build:ios": "expo export -p ios --output-dir dist-ios",
    "preview": "node --experimental-strip-types scripts/serve-web.mjs"
  },
  "dependencies": {
    "expo": "57.0.31",
    "expo-constants": "57.0.22",
    "expo-linking": "57.0.13",
    "expo-router": "57.0.29",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.10",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.10.1",
    "decode-uri-component": "file:vendor/decode-uri-component-cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "typescript": "6.0.3"
  },
  "overrides": {
    "zod": "4.6.7",
    "decode-uri-component": "$decode-uri-component"
  }
}
