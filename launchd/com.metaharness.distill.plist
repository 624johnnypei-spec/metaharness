<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.metaharness.distill</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{PYTHON}}</string>
		<string>{{REPO}}/mh</string>
		<string>distill</string>
	</array>
	<key>WorkingDirectory</key>
	<string>{{REPO}}</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>{{HOME}}</string>
		<key>MH_HOME</key>
		<string>{{ROOT}}</string>
		<key>PATH</key>
		<string>{{PATH}}</string>
	</dict>
	<key>StandardOutPath</key>
	<string>{{STATE}}/distill.out.log</string>
	<key>StandardErrorPath</key>
	<string>{{STATE}}/distill.err.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>3</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
</dict>
</plist>
